{
	"_note": "The mod kit's schema (docs/fallen_modding.md; call 127): what a Fallen mod's manifest and data files may hold. Read by ModKit (scripts/survival/modkit.gd, at load: a mod with a problem is skipped and its problems logged) and by tools/fallen_modkit/validate.py (dry, no Godot). Types: string, int, number (int or float), bool, array, dict, any. A kind's collections are keyed records: 'list' (an array of records each with an 'id') or 'dict' (id -> record). A record whose id is already in the base data is a patch: only the fields it gives are checked; a new id needs every required field. 'refs' name fields holding item ids (they must exist in the base items or the mod's own).",
	"manifest": {
		"required": {"name": "string", "version": "string", "files": "array"},
		"optional": {"load_order": "int", "description": "string", "author": "string", "fallen": "int"}
	},
	"kinds": {
		"items": {"base": "res://data/items.json", "collections": {"items": {"as": "list", "record": "item"}}},
		"zombies": {"base": "code:ZombieAI.KINDS", "collections": {"kinds": {"as": "dict", "record": "zombie"}}},
		"perks": {"base": "code:Perks.ALL", "collections": {"perks": {"as": "dict", "record": "perk"}}},
		"backgrounds": {"base": "code:Backgrounds.ALL+FLAWS", "collections": {"backgrounds": {"as": "dict", "record": "background"}, "flaws": {"as": "dict", "record": "flaw"}}},
		"survival_recipes": {"base": "res://data/survival_recipes.json", "collections": {"recipes": {"as": "dict", "record": "recipe"}}},
		"survival_regions": {"base": "res://data/survival_regions.json", "collections": {"regions": {"as": "dict", "record": "region"}, "types": {"as": "dict", "record": "zone_type"}, "zones": {"as": "dict", "record": "zone"}}},
		"survival_fauna": {"base": "res://data/survival_fauna.json", "collections": {"species": {"as": "dict", "record": "species"}}},
		"survival_flora": {"base": "res://data/survival_flora.json", "collections": {"forage": {"as": "dict", "record": "forage"}, "trees": {"as": "dict", "record": "tree"}, "poisons": {"as": "dict", "record": "poison"}}},
		"survival_lines": {"base": "res://data/survival_lines.json", "collections": {"topics": {"as": "dict", "record": "line_list"}}},
		"arche_trail": {"base": "res://data/arche_trail.json", "collections": {"pieces": {"as": "list", "record": "trail_piece"}, "site_kinds": {"as": "dict", "record": "site_kind"}}},
		"bunkers": {"base": "res://data/bunkers.json", "collections": {"tables": {"as": "dict", "record": "loot_table"}}},
		"loot_tables": {"base": "res://data/loot_tables.json", "collections": {"tables": {"as": "dict", "record": "loot_table"}, "pools": {"as": "dict", "record": "pool"}}},
		"survival_events": {"base": "res://data/survival_events.json", "collections": {"kinds": {"as": "dict", "record": "world_event"}}}
	},
	"records": {
		"item": {"required": {"id": "string", "name": "string", "type": "string", "volume_l": "number", "mass_kg": "number", "desc": "string", "uses": "array"},
			"optional": {"slot": "string", "tags": "array", "stats": "dict", "stack": "int", "capacity_l": "number", "two_handed": "bool"}},
		"zombie": {"required": {"walk": "number", "chase": "number", "sprint": "bool", "pool": "number"},
			"optional": {"scream": "bool", "low": "bool", "trip": "bool", "armoured": "bool", "share": "number", "name": "string"}},
		"perk": {"required": {"name": "string", "text": "string", "fx": "dict"}, "optional": {"needs": "dict", "later": "bool"}},
		"background": {"required": {"name": "string", "lines": "dict", "line": "string"}, "optional": {"perk": "string"}},
		"flaw": {"required": {"name": "string", "points": "int", "text": "string"}, "optional": {"fx": "dict", "later": "bool"}},
		"recipe": {"required": {"name": "string", "inputs": "array", "station": "string", "time_s": "number", "output": "array"},
			"optional": {"tool": "array", "line": "string", "level": "int", "xp": "int", "treat_water": "bool"}, "refs": {"inputs": "pairs", "output": "pair"}},
		"region": {"required": {"name": "string", "climate": "string", "dead": "number", "kinds": "dict"},
			"optional": {"yield": "number", "water": "number", "loot": "dict", "unheld": "bool"}},
		"zone_type": {"required": {"dead": "number"}, "optional": {"evac": "bool"}},
		"zone": {"required": {"region": "string", "type": "string"}, "optional": {}},
		"species": {"required": {"name": "string", "kind": "string", "hp": "number", "speed": "number"},
			"optional": {"herd": "array", "groups": "int", "run": "number", "fear_living_m": "number", "fear_dead_m": "number", "meat": "int", "hide": "int",
				"habitat": "string", "seasons": "dict", "size": "array", "colour": "string", "bite": "number", "turns": "bool"}},
		"forage": {"required": {"name": "string", "on": "array", "share": "number", "item": "string"},
			"optional": {"seasons": "array", "n": "array", "regrow_days": "int", "looks_like": "string", "tell": "int", "poison": "string", "stings": "bool"}, "refs": {"item": "id"}},
		"tree": {"required": {"name": "string", "fell_s": "number", "share": "number"},
			"optional": {"planks": "int", "firewood": "int", "noise_m": "number", "fruit": "string", "fruit_seasons": "array", "fruit_n": "array"}},
		"poison": {"required": {"name": "string", "hours": "number"}, "optional": {"trauma": "number", "line": "string"}},
		"line_list": {"list_of": {"required": {"text": "string"}, "optional": {"voice": "string", "voice_text": "string", "speaker": "dict", "tags": "array"}}},
		"trail_piece": {"required": {"id": "string", "kind": "string", "title": "string", "text": "string"}, "optional": {"site": "string", "theory": "string", "code": "bool"}},
		"site_kind": {"required": {"name": "string"}, "optional": {"zone_type": "string", "count": "int", "regions": "array"}},
		"loot_table": {"required": {}, "optional": {"common": "array", "uncommon": "array", "rare": "array", "very_rare": "array"}, "refs": {"common": "bundles", "uncommon": "bundles", "rare": "bundles", "very_rare": "bundles"}},
		"pool": {"required": {"table": "string", "tier_weights": "dict"}, "optional": {}},
		"world_event": {"required": {"weight": "number", "window_h": "number", "text": "string"},
			"optional": {"pressure": "number", "label": "string", "loot": "array", "rolls": "int", "richness": "number", "reach_links": "int", "broadcast": "string",
				"taken": "string", "lapsed": "string", "ambush_chance": "number", "trade_share": "number", "ambushed": "string", "passed": "string", "robbed": "string",
				"crew": "int", "reward": "number", "recovered": "string", "lost": "string", "player_pressure": "number", "ring_s": "number", "ring_every_s": "number",
				"ring_m": "number", "cult_text": "string", "player_text": "string", "richness_mult": "number", "glow_links": "int", "out": "string", "passing": "string"},
			"refs": {"loot": "rows"}}
	}
}
